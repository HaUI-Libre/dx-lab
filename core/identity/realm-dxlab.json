{
  "realm": "${KEYCLOAK_REALM}",
  "displayName": "DX-Lab",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "defaultLocale": "vi",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "roles": {
    "realm": [
      {
        "name": "ROLE_STUDENT",
        "description": "Sinh viên / người dùng dịch vụ: tạo và theo dõi yêu cầu hỗ trợ"
      },
      {
        "name": "ROLE_TECHNICIAN",
        "description": "Kỹ thuật viên: tiếp nhận, xử lý yêu cầu và lập biên bản"
      },
      {
        "name": "ROLE_LAB_MANAGER",
        "description": "Trưởng phòng lab: phân loại, phân công, nghiệm thu, xem dashboard"
      },
      {
        "name": "ROLE_ADMIN",
        "description": "Quản trị viên hệ thống DX-OS"
      }
    ]
  },
  "clients": [
    {
      "clientId": "${KEYCLOAK_CLIENT_ID}",
      "name": "DX-Lab App",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${APP_URL}/*",
        "http://localhost:9080/*"
      ],
      "webOrigins": [
        "${APP_URL}",
        "http://localhost:9080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_URL}/*##http://localhost:9080/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "co_so",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "co_so",
            "claim.name": "co_so",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "dxlab-data-api",
      "name": "DX-Lab Data API",
      "description": "Service account của Data API, chỉ có quyền xem người dùng để kiểm tra kỹ thuật viên và cơ sở",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DATA_API_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
