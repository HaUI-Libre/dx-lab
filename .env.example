#
# Tạo .env bằng `make env`: các giá trị "changeme" được thay bằng chuỗi ngẫu nhiên,
# trừ DEMO_USER_PASSWORD. KHÔNG commit file .env.

# --- PostgreSQL ---
POSTGRES_USER=dxlab
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dxlab
POSTGRES_PORT=5432
# Mỗi dịch vụ có database và user riêng (tạo bởi core/postgres/init)
KEYCLOAK_DB_PASSWORD=changeme
FLOWABLE_DB_PASSWORD=changeme
DATA_DB_PASSWORD=changeme

# --- Keycloak (Identity/SSO) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_REALM=dxlab
KEYCLOAK_CLIENT_ID=dxlab-app
KEYCLOAK_CLIENT_SECRET=changeme
# Secret của client dxlab-data-api (service account chỉ xem người dùng, dùng bởi Data API)
DATA_API_CLIENT_SECRET=changeme

# --- Apache APISIX (API Gateway) ---
# Chạy standalone (route trong core/gateway/apisix.yaml), không mở Admin API
GATEWAY_PORT=9080

# --- Flowable (Workflow) ---
# Tài khoản REST nội bộ; APISIX dùng sau khi xác thực Keycloak, không publish cổng Flowable.
FLOWABLE_ADMIN_USER=admin
FLOWABLE_ADMIN_PASSWORD=changeme
# REST nội bộ dùng bởi init deploy; không publish cổng Flowable.
FLOWABLE_INTERNAL_URL=http://flowable:8080/flowable-rest/service
# Khóa chia sẻ chỉ giữa Data API và APISIX; thay bằng chuỗi ngẫu nhiên dài trước khi chạy.
DATA_WORKFLOW_KEY=changeme
# URL API nội bộ qua APISIX; Compose dùng route mặc định khi biến để trống.
DATA_ASSET_STATUS_URL=
DATA_ASSET_URL=http://apisix:9080/api/assets
# Khóa riêng cho API cập nhật tài sản nội bộ; đổi trước khi bật URL trên.
DATA_ASSET_KEY=changeme
# Nhãn sửa chữa và ID vị trí gốc của 3 cơ sở trong Snipe-IT.
ASSET_REPAIR_LABEL="Đang sửa chữa"
ASSET_SITE_ROOTS=1:CS1,9:CS2,15:CS3

# --- SeaweedFS (Object storage) ---
# Không cần biến: chưa bật S3, tệp đi qua /api/files của gateway.

# --- Tài khoản demo ---
DEMO_USER_PASSWORD=changeme
# Nút vào thử theo vai trò ở trang đăng nhập: chỉ điền sẵn tên qua login_hint, không điền
# mật khẩu. Tắt (false) khi chạy ngoài buổi demo.
DEMO_LOGIN_HINTS=true

# --- Ứng dụng DX-Helpdesk (Nuxt) ---
APP_PORT=3000
# Khoá mã hoá cookie phiên, ít nhất 32 ký tự. Tạo bằng: openssl rand -hex 32
APP_SESSION_PASSWORD=changeme-changeme-changeme-changeme

# --- Snipe-IT & MariaDB (Profile: integration) ---
# Quản lý tài sản (giả lập hệ thống có sẵn của khách hàng, ngoài DX-OS).
# Cổng Snipe-IT chỉ mở trên loopback 127.0.0.1; MariaDB không mở cổng ra ngoài.
SNIPEIT_PORT=8081
# Nếu để changeme hoặc rỗng, container tự sinh APP_KEY và lưu vào volume snipeit-data
SNIPEIT_APP_KEY=changeme
MARIADB_ROOT_PASSWORD=changeme
SNIPEIT_DB_DATABASE=snipeit
SNIPEIT_DB_USERNAME=snipeit
SNIPEIT_DB_PASSWORD=changeme
SNIPEIT_ADMIN_USER=admin
SNIPEIT_ADMIN_PASSWORD=changeme
# API Token cho dịch vụ tích hợp được sinh tự động vào volume snipeit-token (/token/snipeit_api_token)
SNIPEIT_API_URL=http://snipeit/api/v1
ASSET_RETRY_SECONDS=60
# NATS JetStream trong profile integration (#77); Data API phát sự kiện đổi trạng thái lên đây
NATS_URL=nats://nats:4222

# --- Giám sát (Profile: monitoring, #78) ---
# Grafana chỉ bind 127.0.0.1; 3000 là cổng của ứng dụng nên Grafana dùng 3001
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
# Role dxmonitor (pg_monitor) cho postgres_exporter, tạo khi khởi tạo volume PostgreSQL
MONITOR_DB_PASSWORD=changeme

