# Sao chép thành .env rồi đổi các giá trị "changeme". KHÔNG commit file .env.

# --- PostgreSQL ---
POSTGRES_USER=dxlab
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dxlab

# --- Keycloak (Identity/SSO) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_REALM=dxlab
KEYCLOAK_CLIENT_ID=dxlab-app
KEYCLOAK_CLIENT_SECRET=changeme

# --- Apache APISIX (API Gateway) ---
APISIX_ADMIN_KEY=changeme

# --- Flowable (Workflow) ---
FLOWABLE_ADMIN_USER=admin
FLOWABLE_ADMIN_PASSWORD=changeme

# --- SeaweedFS (Object storage) ---
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme

# --- AI ---
OLLAMA_MODEL=qwen2.5:1.5b
AI_FALLBACK_RULE_BASED=true

# --- Tài khoản demo ---
DEMO_USER_PASSWORD=changeme
