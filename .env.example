#
# Tạo .env bằng `make env`: các giá trị "changeme" được thay bằng chuỗi ngẫu nhiên,
# trừ DEMO_USER_PASSWORD. KHÔNG commit file .env.

# --- PostgreSQL ---
POSTGRES_USER=dxlab
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dxlab
POSTGRES_PORT=5432
# Mỗi dịch vụ có database và user riêng (tạo bởi core/postgres/init)
KEYCLOAK_DB_PASSWORD=changeme
FLOWABLE_DB_PASSWORD=changeme
DATA_DB_PASSWORD=changeme

# --- Keycloak (Identity/SSO) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_REALM=dxlab
KEYCLOAK_CLIENT_ID=dxlab-app
KEYCLOAK_CLIENT_SECRET=changeme
# Secret của client dxlab-data-api (service account chỉ xem người dùng, dùng bởi Data API)
DATA_API_CLIENT_SECRET=changeme

# --- Apache APISIX (API Gateway) ---
# Chạy standalone (route trong core/gateway/apisix.yaml), không mở Admin API
GATEWAY_PORT=9080

# --- Flowable (Workflow) ---
# Tài khoản REST nội bộ; APISIX dùng sau khi xác thực Keycloak, không publish cổng Flowable.
FLOWABLE_ADMIN_USER=admin
FLOWABLE_ADMIN_PASSWORD=changeme
# REST nội bộ dùng bởi init deploy; không publish cổng Flowable.
FLOWABLE_INTERNAL_URL=http://flowable:8080/flowable-rest/service
# Khóa chia sẻ chỉ giữa Data API và APISIX; thay bằng chuỗi ngẫu nhiên dài trước khi chạy.
DATA_WORKFLOW_KEY=changeme
# URL API nội bộ của dịch vụ tích hợp tài sản (#72); để trống đến khi dịch vụ sẵn sàng.
DATA_ASSET_STATUS_URL=
# Khóa riêng cho API cập nhật tài sản nội bộ; đổi trước khi bật URL trên.
DATA_ASSET_KEY=changeme

# --- SeaweedFS (Object storage) ---
# Không cần biến: chưa bật S3, tệp đi qua /api/files của gateway.

# --- Tài khoản demo ---
DEMO_USER_PASSWORD=changeme

# --- Ứng dụng DX-Helpdesk (Nuxt) ---
APP_PORT=3000
# Khoá mã hoá cookie phiên, ít nhất 32 ký tự. Tạo bằng: openssl rand -hex 32
APP_SESSION_PASSWORD=changeme-changeme-changeme-changeme
